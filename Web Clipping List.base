filters:
  and:
    - type == "web-clipping"
views:
  - type: cards
    name: View
    order:
      - file.name
      - description
      - site
      - author
      - created
    sort:
      - property: created
        direction: DESC
    image: note.image
    imageFit: contain
    imageAspectRatio: 0.6
    cardSize: 220
  - type: table
    name: Table
